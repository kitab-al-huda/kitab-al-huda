# =============================================================================
# .env.example — Template de configuration (à copier vers .env)
# =============================================================================
# 📋 Instructions :
#   1. Copiez ce fichier : cp .env.example .env
#   2. Remplissez les valeurs dans .env
#   3. Ne modifiez jamais .env.example avec de vrais secrets
#
# Ce fichier PEUT être commité dans Git (il ne contient pas de secrets).
# =============================================================================

# --- Variables de Build et Configurations App ---
INTERNAL_BUILD_ID=VOTRE_SIGNATURE_ICI

# --- Valeurs chiffrées (générées par encrypt.py) ---
API_ENDPOINT_BASE=VALEUR_CHIFFREE_ICI
API_SERVICE_IDENTIFIER=VALEUR_CHIFFREE_ICI
API_AUTH_SIGNATURE=VALEUR_CHIFFREE_ICI
