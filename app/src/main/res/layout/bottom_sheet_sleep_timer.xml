<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/sleep_timer"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/time_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="15 minutes"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/time_30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="30 minutes"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/time_45"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="45 minutes"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/time_60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="60 minutes"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/time_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Turn off timer"
        android:textColor="@android:color/holo_red_dark"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
